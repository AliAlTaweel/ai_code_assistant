{
  "name": "skillsmatch-mcp",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@skillsmatch/agent && npm run typecheck --workspace=@skillsmatch/web",
    "db:apply-schema": "tsx db/apply.ts db/schema.sql $DATABASE_URL",
    "db:seed": "tsx db/apply.ts db/seed.sql $DATABASE_URL",
    "db:generate-embeddings": "tsx db/generate-embeddings.ts",
    "evals": "tsx evals/runner.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.12.0"
  }
}
